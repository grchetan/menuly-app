# ==============================================================================
# MENULY ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your real .env file or credentials to GitHub!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONNECTION (Supabase PostgreSQL + Prisma ORM)
# ------------------------------------------------------------------------------
# In Supabase Project Settings -> Database -> Connection string:
# For Prisma in production, use the Transaction Pooler (port 6543) with ?pgbouncer=true
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct connection for Prisma migrations and schema push (port 5432)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# 2. SUPABASE API (Optional for client-side legacy / storage)
# ------------------------------------------------------------------------------
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_PUBLISHABLE_KEY="[YOUR-SUPABASE-ANON-KEY]"
VITE_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="[YOUR-SUPABASE-ANON-KEY]"

# ------------------------------------------------------------------------------
# 3. GMAIL SMTP CONFIGURATION (Custom OTP Authentication)
# ------------------------------------------------------------------------------
# Using Gmail SMTP with your Menuly account
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="menulyoffcial@gmail.com"
# 16-character Google App Password (generated from Google Account Security)
SMTP_PASS="your-16-char-gmail-app-password"
SMTP_FROM_NAME="Menuly"
SMTP_FROM_EMAIL="menulyoffcial@gmail.com"

# ------------------------------------------------------------------------------
# 4. JWT & AUTHENTICATION SECURITY
# ------------------------------------------------------------------------------
# Generate a strong random 64-character secret string: openssl rand -hex 32
JWT_SECRET="generate-a-strong-random-secret-key-at-least-32-chars-long"
JWT_EXPIRES_IN="7d"
REFRESH_TOKEN_SECRET="generate-another-strong-random-refresh-secret-key"
REFRESH_TOKEN_EXPIRES_IN="30d"

# OTP Security settings
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ------------------------------------------------------------------------------
# 5. INITIAL SUPER ADMIN SEED (For running seed script)
# ------------------------------------------------------------------------------
SUPER_ADMIN_EMAIL="admin@menuly.com"
SUPER_ADMIN_PASSWORD="ChangeThisPassword123!"

# ------------------------------------------------------------------------------
# 6. APPLICATION CONFIG
# ------------------------------------------------------------------------------
APP_URL="http://localhost:3000"
PORT=3000
NODE_ENV="development"
